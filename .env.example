APP_ENV=local
APP_NAME=Marketplace Learning API
APP_HOST=0.0.0.0
APP_PORT=8000
# Optional Docker-only overrides; see docs/DOCKER.md.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# PROXY_PORT=8080
# DOCKER_OTLP_ENDPOINT=http://jaeger:4317
APP_DOCS_ENABLED=true
APP_DEBUG=false
DATABASE_URL=postgresql+asyncpg://marketplace:marketplace@localhost:5432/marketplace
DATABASE_READ_REPLICA_URL=
SHARED_SCHEMA=shared
REDIS_URL=redis://localhost:6379/0
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_ISSUER=marketplace
JWT_AUDIENCE=marketplace-mobile
REFRESH_TOKEN_DAYS=30
LOCAL_PAYMENTS_ENABLED=true
LOCAL_EMAIL_TOKENS_ENABLED=true
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=20
SUPPORTED_CURRENCIES=["USD"]
COMMISSION_BPS=1000
CHECKOUT_EXPIRY_MINUTES=30
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver","app"]
CORS_ORIGINS=[]
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=marketplace
METRICS_ENABLED=true
METRICS_PATH=/metrics
OTEL_SERVICE_NAME=marketplace
OTLP_ENDPOINT=http://localhost:4317
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_READ_POOL_SIZE=10
DB_READ_MAX_OVERFLOW=20
DB_READ_POOL_TIMEOUT=30
DB_READ_POOL_RECYCLE=3600
