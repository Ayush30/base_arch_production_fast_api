# Application
APP_ENV=local
APP_NAME=sgi-backend
APP_VERSION=0.1.0
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DOCS_ENABLED=true
APP_DEBUG=true
SECRET_KEY=change-me-in-production

# Database — primary (write) connection
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/sgi_backend

# Primary connection pool
DB_POOL_SIZE=10           # increase to 20-50 for higher concurrency in production
DB_MAX_OVERFLOW=20        # extra connections allowed above pool_size
DB_POOL_TIMEOUT=30        # seconds to wait for a free connection before raising PoolTimeout
DB_POOL_RECYCLE=3600      # recycle connections after 1 h to prevent stale TCP

# Read replica — set to replica DSN in production; leave empty to use primary for reads
DATABASE_READ_REPLICA_URL=

# Read replica connection pool (only active when DATABASE_READ_REPLICA_URL is non-empty)
DB_READ_POOL_SIZE=10
DB_READ_MAX_OVERFLOW=20
DB_READ_POOL_TIMEOUT=30
DB_READ_POOL_RECYCLE=3600

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT (RS256)
JWT_ALGORITHM=RS256
JWT_PUBLIC_KEY_PATH=keys/public.pem
# In prod, mount the private key as a secret
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenTelemetry
OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=sgi-backend
METRICS_ENABLED=true
METRICS_PATH=/metrics

# Kafka — publishes audit events, consumed by audit-service. Points at the shared
# Kafka broker owned by auth-service's docker-compose.yml (external `sgi-network`).
# This value is for running the app directly on the host (localhost:9092);
# docker-compose.yml hardcodes `kafka:9092` for the containerized run, so it is
# unaffected by whatever is set here.
# Topic names are not configured here — see src/app/kafka/constants.py.
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=sgi-backend

# Tenancy
TENANT_SCHEMA_PREFIX=tenant_
SHARED_SCHEMA=shared
